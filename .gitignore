# Build artifacts
/target
**/*.rs.bk
*.pdb

# Vendored C build outputs. The C *source* is tracked and its provenance is
# recorded in vendor/UPSTREAM.lock; build.rs compiles it into OUT_DIR.
vendor/**/*.o
vendor/**/*.a
vendor/**/*.so
vendor/**/*.dylib
vendor/**/*.dll

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local scratch
/tmp/
/scratch/
