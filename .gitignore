# Build artifacts
/target
**/node_modules/
**/*.rs.bk
*.pdb

# Vendored C build outputs. The C *source* is tracked and its provenance is
# recorded in vendor/UPSTREAM.lock; build.rs compiles it into OUT_DIR.
libvscode-diff/**/*.o
libvscode-diff/**/*.a
libvscode-diff/**/*.so
libvscode-diff/**/*.dylib
libvscode-diff/**/*.dll

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local scratch
/tmp/
/scratch/
